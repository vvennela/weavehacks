[{"name": "existing-sme", "hypothesis": "Unchanged AC baseline", "source_hash": "3719c58530161598ab9a537a43be749a5287c8d8dbd35b855e5afea97cd15258", "status": "passed", "scores": [1270.2012501061822, 1445.789816356168, 1536.8500954022952], "control_scores": [], "promoted": null, "adjudication": null, "error": null, "comparison_identity": {"tree_hash": "76db49356748c18dccac376bed489268b047b60a", "config": {"n": 512, "tolerance": 0.002, "machine": "MacBook-Pro-8.local"}, "runtime": {"compiler": "Apple clang version 21.0.0 (clang-2100.1.1.101)", "compiler_flags": ["-O3", "-march=native", "-ffast-math", "-shared", "-fPIC", "-lm"], "architecture": "arm64", "platform": "Darwin"}}, "source": "#include <arm_sve.h>\n#include <arm_sme.h>\n#include <stdlib.h>\n#include <stddef.h>\n\n/* Transpose through ZA: contiguous row loads become contiguous column stores.\n * The heap layout remains at[k*n+i], exactly as consumed by sme_gemm. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_transpose(int n, const float *a, float *at) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        const int rows0 = n-i < vl ? n-i : vl;\n        const int rows1 = n-i-vl < vl ? n-i-vl : vl;\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int k = 0; k < n; k += 2*vl) {\n            const int cols0 = n-k < vl ? n-k : vl;\n            const int cols1 = n-k-vl < vl ? n-k-vl : vl;\n            svbool_t pk0 = svwhilelt_b32(k, n);\n            svbool_t pk1 = svwhilelt_b32(k+vl, n);\n            for (int r = 0; r < rows0; ++r) {\n                svld1_hor_za32(0, r, pk0, a+(size_t)(i+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(1, r, pk1, a+(size_t)(i+r)*n+k+vl);\n            }\n            for (int r = 0; r < rows1; ++r) {\n                svld1_hor_za32(2, r, pk0, a+(size_t)(i+vl+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(3, r, pk1, a+(size_t)(i+vl+r)*n+k+vl);\n            }\n            for (int s = 0; s < cols0; ++s) {\n                svst1_ver_za32(0, s, pi0, at+(size_t)(k+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(2, s, pi1, at+(size_t)(k+s)*n+i+vl);\n            }\n            for (int s = 0; s < cols1; ++s) {\n                svst1_ver_za32(1, s, pi0, at+(size_t)(k+vl+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(3, s, pi1, at+(size_t)(k+vl+s)*n+i+vl);\n            }\n        }\n    }\n}\n\n/* CPU SME outer products: four ZA tiles hold a 2VL x 2VL output block. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_gemm(int n,const float *at,const float *b,float *c) {\n    const int vl=(int)svcntsw();\n    for(int i=0;i<n;i+=2*vl) {\n        svbool_t pi0=svwhilelt_b32(i,n),pi1=svwhilelt_b32(i+vl,n);\n        for(int j=0;j<n;j+=2*vl) {\n            svbool_t pj0=svwhilelt_b32(j,n),pj1=svwhilelt_b32(j+vl,n);\n            svzero_za();\n            for(int k=0;k<n;k++) {\n                svfloat32_t a0=svld1_f32(pi0,at+(size_t)k*n+i);\n                svfloat32_t a1=svld1_f32(pi1,at+(size_t)k*n+(i+vl<n?i+vl:i));\n                svfloat32_t b0=svld1_f32(pj0,b+(size_t)k*n+j);\n                svfloat32_t b1=svld1_f32(pj1,b+(size_t)k*n+(j+vl<n?j+vl:j));\n                svmopa_za32_f32_m(0,pi0,pj0,a0,b0);\n                svmopa_za32_f32_m(1,pi0,pj1,a0,b1);\n                svmopa_za32_f32_m(2,pi1,pj0,a1,b0);\n                svmopa_za32_f32_m(3,pi1,pj1,a1,b1);\n            }\n            for(int r=0;r<vl && i+r<n;r++) {\n                svst1_hor_za32(0,r,pj0,c+(size_t)(i+r)*n+j);\n                if(j+vl<n) svst1_hor_za32(1,r,pj1,c+(size_t)(i+r)*n+j+vl);\n            }\n            for(int r=0;r<vl && i+vl+r<n;r++) {\n                svst1_hor_za32(2,r,pj0,c+(size_t)(i+vl+r)*n+j);\n                if(j+vl<n) svst1_hor_za32(3,r,pj1,c+(size_t)(i+vl+r)*n+j+vl);\n            }\n        }\n    }\n}\nvoid gemm(int n,const float *restrict A,const float *restrict B,float *restrict C) {\n    if(n<=0)return;\n    float *at=malloc((size_t)n*n*sizeof(float));\n    if(!at) {\n        for(int i=0;i<n;i++)for(int j=0;j<n;j++) {\n            float x=0;for(int k=0;k<n;k++)x+=A[(size_t)i*n+k]*B[(size_t)k*n+j];\n            C[(size_t)i*n+j]=x;\n        }\n        return;\n    }\n    sme_transpose(n, A, at);\n    sme_gemm(n,at,B,C);\n    free(at);\n}\n"}, {"name": "sme_fp32_tiles", "hypothesis": "Interchange the column-tile and reduction loops to load each pair of A vectors once per reduction step. Four FP32 ZA tiles hold one output block, so partial sums must be stored to C and reloaded between reduction steps. This added traffic may outweigh A-load reuse. Correctness and performance are unverified; no promotion decision is supported yet.", "source_hash": "3ba1eae036e72c1b089d9dad7a788cc1d232a0026dd78503835bd8ca0c250c68", "status": "passed", "scores": [47.93241209471232, 49.597756196464964, 47.70277766706538], "control_scores": [1510.1854052116528, 1226.6624724723301, 1145.3246378666672], "promoted": false, "adjudication": null, "error": null, "comparison_identity": {"tree_hash": "76db49356748c18dccac376bed489268b047b60a", "config": {"n": 512, "tolerance": 0.002, "machine": "MacBook-Pro-8.local"}, "runtime": {"compiler": "Apple clang version 21.0.0 (clang-2100.1.1.101)", "compiler_flags": ["-O3", "-march=native", "-ffast-math", "-shared", "-fPIC", "-lm"], "architecture": "arm64", "platform": "Darwin"}}, "source": "#include <arm_sve.h>\n#include <arm_sme.h>\n#include <stdlib.h>\n#include <stddef.h>\n\n/* Preserve the full transpose layout: at[k*n+i]. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_transpose(int n, const float *a, float *at) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        const int rows0 = n-i < vl ? n-i : vl;\n        const int rows1 = n-i-vl < vl ? n-i-vl : vl;\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int k = 0; k < n; k += 2*vl) {\n            const int cols0 = n-k < vl ? n-k : vl;\n            const int cols1 = n-k-vl < vl ? n-k-vl : vl;\n            svbool_t pk0 = svwhilelt_b32(k, n);\n            svbool_t pk1 = svwhilelt_b32(k+vl, n);\n            for (int r = 0; r < rows0; ++r) {\n                svld1_hor_za32(0, r, pk0, a+(size_t)(i+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(1, r, pk1, a+(size_t)(i+r)*n+k+vl);\n            }\n            for (int r = 0; r < rows1; ++r) {\n                svld1_hor_za32(2, r, pk0, a+(size_t)(i+vl+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(3, r, pk1, a+(size_t)(i+vl+r)*n+k+vl);\n            }\n            for (int s = 0; s < cols0; ++s) {\n                svst1_ver_za32(0, s, pi0, at+(size_t)(k+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(2, s, pi1, at+(size_t)(k+s)*n+i+vl);\n            }\n            for (int s = 0; s < cols1; ++s) {\n                svst1_ver_za32(1, s, pi0, at+(size_t)(k+vl+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(3, s, pi1, at+(size_t)(k+vl+s)*n+i+vl);\n            }\n        }\n    }\n}\n\n/* Reuse A vectors across all column tiles at each increasing k.\n * ZA mapping: 0 = upper left, 1 = lower left,\n *             2 = upper right, 3 = lower right.\n * C holds FP32 partial sums while ZA processes other column tiles.\n * The first reduction step initializes each block without reading C.\n */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_gemm(int n, const float *at, const float *b, float *c) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        const int second_row = i+vl < n ? i+vl : i;\n\n        for (int k = 0; k < n; ++k) {\n            svfloat32_t a0 = svld1_f32(pi0, at+(size_t)k*n+i);\n            svfloat32_t a1 = svld1_f32(pi1, at+(size_t)k*n+second_row);\n\n            for (int j = 0; j < n; j += 2*vl) {\n                svbool_t pj0 = svwhilelt_b32(j, n);\n                svbool_t pj1 = svwhilelt_b32(j+vl, n);\n                const int second_col = j+vl < n ? j+vl : j;\n\n                if (k == 0) {\n                    svzero_za();\n                } else {\n                    for (int r = 0; r < vl && i+r < n; ++r) {\n                        svld1_hor_za32(0, r, pj0, c+(size_t)(i+r)*n+j);\n                        if (j+vl < n)\n                            svld1_hor_za32(2, r, pj1, c+(size_t)(i+r)*n+j+vl);\n                    }\n                    for (int r = 0; r < vl && i+vl+r < n; ++r) {\n                        svld1_hor_za32(1, r, pj0, c+(size_t)(i+vl+r)*n+j);\n                        if (j+vl < n)\n                            svld1_hor_za32(3, r, pj1, c+(size_t)(i+vl+r)*n+j+vl);\n                    }\n                }\n\n                svfloat32_t b0 = svld1_f32(pj0, b+(size_t)k*n+j);\n                svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                svmopa_za32_f32_m(1, pi1, pj0, a1, b0);\n                svfloat32_t b1 = svld1_f32(pj1, b+(size_t)k*n+second_col);\n                svmopa_za32_f32_m(2, pi0, pj1, a0, b1);\n                svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n\n                for (int r = 0; r < vl && i+r < n; ++r) {\n                    svst1_hor_za32(0, r, pj0, c+(size_t)(i+r)*n+j);\n                    if (j+vl < n)\n                        svst1_hor_za32(2, r, pj1, c+(size_t)(i+r)*n+j+vl);\n                }\n                for (int r = 0; r < vl && i+vl+r < n; ++r) {\n                    svst1_hor_za32(1, r, pj0, c+(size_t)(i+vl+r)*n+j);\n                    if (j+vl < n)\n                        svst1_hor_za32(3, r, pj1, c+(size_t)(i+vl+r)*n+j+vl);\n                }\n            }\n        }\n    }\n}\n\nvoid gemm(int n, const float *restrict A, const float *restrict B,\n          float *restrict C) {\n    if (n <= 0)\n        return;\n\n    float *at = malloc((size_t)n*n*sizeof(float));\n    if (!at) {\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                float x = 0;\n                for (int k = 0; k < n; ++k)\n                    x += A[(size_t)i*n+k]*B[(size_t)k*n+j];\n                C[(size_t)i*n+j] = x;\n            }\n        }\n        return;\n    }\n\n    sme_transpose(n, A, at);\n    sme_gemm(n, at, B, C);\n    free(at);\n}\n"}]
