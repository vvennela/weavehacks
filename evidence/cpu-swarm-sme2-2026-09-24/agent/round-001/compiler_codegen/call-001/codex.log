/z, [x28]", "add\tx28, x2, x12", "ld1w\t{ z2.s }, p2/z, [x28]", "add\tx28, x14, x12", "ld1w\t{ z3.s }, p3/z, [x28]", "fmopa\tza0.s, p0/m, p2/m, z0.s, z2.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z3.s", "fmopa\tza2.s, p1/m, p2/m, z1.s, z2.s", "fmopa\tza3.s, p1/m, p3/m, z1.s, z3.s", "add\tx12, x12, x15", "subs\tx22, x22, #1", "b.ne\tLBB2_11"]}], "all_blocks_count": 2, "baseline_conditions": "Prior AC block; user was not asked to remain idle", "source": "#include <arm_sve.h>\n#include <arm_sme.h>\n#include <stdlib.h>\n#include <stddef.h>\n\n/* Preserve the full transpose layout: at[k*n+i]. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_transpose(int n, const float *a, float *at) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        const int rows0 = n-i < vl ? n-i : vl;\n        const int rows1 = n-i-vl < vl ? n-i-vl : vl;\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int k = 0; k < n; k += 2*vl) {\n            const int cols0 = n-k < vl ? n-k : vl;\n            const int cols1 = n-k-vl < vl ? n-k-vl : vl;\n            svbool_t pk0 = svwhilelt_b32(k, n);\n            svbool_t pk1 = svwhilelt_b32(k+vl, n);\n            for (int r = 0; r < rows0; ++r) {\n                svld1_hor_za32(0, r, pk0, a+(size_t)(i+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(1, r, pk1, a+(size_t)(i+r)*n+k+vl);\n            }\n            for (int r = 0; r < rows1; ++r) {\n                svld1_hor_za32(2, r, pk0, a+(size_t)(i+vl+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(3, r, pk1, a+(size_t)(i+vl+r)*n+k+vl);\n            }\n            for (int s = 0; s < cols0; ++s) {\n                svst1_ver_za32(0, s, pi0, at+(size_t)(k+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(2, s, pi1, at+(size_t)(k+s)*n+i+vl);\n            }\n            for (int s = 0; s < cols1; ++s) {\n                svst1_ver_za32(1, s, pi0, at+(size_t)(k+vl+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(3, s, pi1, at+(size_t)(k+vl+s)*n+i+vl);\n            }\n        }\n    }\n}\n\n/* Four FP32 ZA tiles hold a 2VL x 2VL output block. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_gemm(int n, const float *at, const float *b, float *c) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int j = 0; j < n; j += 2*vl) {\n            svbool_t pj0 = svwhilelt_b32(j, n);\n            svbool_t pj1 = svwhilelt_b32(j+vl, n);\n            svzero_za();\n\n            if (n == 512 && i+2*vl <= n && j+2*vl <= n) {\n                const float *ap = at+i;\n                const float *bp = b+j;\n\n                /* Steps 0 through 510 advance to the next valid row. */\n                for (int k = 0; k < 511; ++k) {\n                    svfloat32_t a0 = svld1_f32(pi0, ap);\n                    svfloat32_t a1 = svld1_f32(pi1, ap+vl);\n                    svfloat32_t b0 = svld1_f32(pj0, bp);\n                    svfloat32_t b1 = svld1_f32(pj1, bp+vl);\n                    svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                    svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                    svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                    svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n                    ap += 512;\n                    bp += 512;\n                }\n\n                /* Step 511 does not advance either pointer. */\n                svfloat32_t a0 = svld1_f32(pi0, ap);\n                svfloat32_t a1 = svld1_f32(pi1, ap+vl);\n                svfloat32_t b0 = svld1_f32(pj0, bp);\n                svfloat32_t b1 = svld1_f32(pj1, bp+vl);\n                svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n            } else {\n                /* Original reduction for other sizes and partial tiles. */\n                for (int k = 0; k < n; ++k) {\n                    svfloat32_t a0 = svld1_f32(pi0, at+(size_t)k*n+i);\n                    svfloat32_t a1 = svld1_f32(pi1, at+(size_t)k*n+(i+vl<n ? i+vl : i));\n                    svfloat32_t b0 = svld1_f32(pj0, b+(size_t)k*n+j);\n                    svfloat32_t b1 = svld1_f32(pj1, b+(size_t)k*n+(j+vl<n ? j+vl : j));\n                    svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                    svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                    svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                    svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n                }\n            }\n\n            for (int r = 0; r < vl && i+r < n; ++r) {\n                svst1_hor_za32(0, r, pj0, c+(size_t)(i+r)*n+j);\n                if (j+vl < n)\n                    svst1_hor_za32(1, r, pj1, c+(size_t)(i+r)*n+j+vl);\n            }\n            for (int r = 0; r < vl && i+vl+r < n; ++r) {\n                svst1_hor_za32(2, r, pj0, c+(size_t)(i+vl+r)*n+j);\n                if (j+vl < n)\n                    svst1_hor_za32(3, r, pj1, c+(size_t)(i+vl+r)*n+j+vl);\n            }\n        }\n    }\n}\n\nvoid gemm(int n, const float *restrict A, const float *restrict B,\n          float *restrict C) {\n    if (n <= 0)\n        return;\n\n    float *at = malloc((size_t)n*n*sizeof(float));\n    if (!at) {\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                float x = 0;\n                for (int k = 0; k < n; ++k)\n                    x += A[(size_t)i*n+k]*B[(size_t)k*n+j];\n                C[(size_t)i*n+j] = x;\n            }\n        }\n        return;\n    }\n\n    sme_transpose(n, A, at);\n    sme_gemm(n, at, B, C);\n    free(at);\n}\n"}, {"name": "address_generation", "source_hash": "cd2558e0573d6fbc768798acbc1cb9e12c8dfff68125c7e110a1bfc51fd77993", "scores": [1403.8923582133943, 1302.8254106184925, 1524.8462856172978], "control_scores": [1528.8237096613148, 1007.1075621145387, 1444.1718924026168], "hypothesis": "Replace indexed reduction loads with four advancing pointers for every matrix size. Advance only when another reduction step remains. Preserve predicates, ZA selectors 0\u20133, FP32 reduction order, transpose, and tail handling. This differs from the tested n=512-only pointer path. Compilation, correctness, and performance remain unverified; retain the incumbent pending correctness checks and repeated paired AC trials.", "adjudication": {"decision": "revise", "reason": "The candidate passed the supplied correctness checks, but eligible=false blocks adoption. Paired AC throughput changes were \u22128.2%, +29.4%, and +5.6%. Candidate scores ranged from 1302.83\u20131524.85 GFLOP/s; controls ranged from 1007.11\u20131528.82 GFLOP/s. The mixed results and large repeat variation do not establish a stable gain or its cause. Retain the incumbent and use this inconclusive evidence to inform the next jointly ranked implementation under unchanged gates."}, "compiler": "Apple clang21 with fixed optimization flags", "fmopa_basic_blocks": [{"function": "_sme_gemm", "label": "LBB2_7", "instructions": ["ld1w\t{ z0.s }, p0/z, [x30]", "ld1w\t{ z1.s }, p1/z, [x20]", "ld1w\t{ z2.s }, p2/z, [x25]", "ld1w\t{ z3.s }, p3/z, [x26]", "cmp\tw27, w0", "lsl\tx12, x11, #2", "add\tx14, x30, x12", "add\tx3, x20, x12", "fmopa\tza0.s, p0/m, p2/m, z0.s, z2.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z3.s", "add\tx5, x25, x12", "add\tx12, x26, x12", "csel\tx26, x26, x12, hs", "csel\tx25, x25, x5, hs", "fmopa\tza2.s, p1/m, p2/m, z1.s, z2.s", "fmopa\tza3.s, p1/m, p3/m, z1.s, z3.s", "csel\tx20, x20, x3, hs", "csel\tx30, x30, x14, hs", "add\tw27, w27, #1", "subs\tw28, w28, #1", "b.ne\tLBB2_7", "cmp\tw9, #1", "b.lt\tLBB2_5", "cmp\tw0, w24", "b.le\tLBB2_13", "mov\tx12, #0                         ; =0x0", "mov\tx14, #0                         ; =0x0"]}], "all_blocks_count": 1, "baseline_conditions": "Prior AC block; user was not asked to remain idle", "source": null}, {"name": "register_reuse", "source_hash": "4689487fd76f9eca947abb1ae73b38f0c25c7241665505cc1918183649b24d40", "scores": [811.6968370669714, 1483.0687329294026, 1393.564905406668], "control_scores": [1597.0410543776825, 1017.6027289204618, 1505.24829301313], "hypothesis": "Starting from the unchanged incumbent, load A0 and both B vectors, issue the two MOPAs using A0, then load A1 and issue its two MOPAs. Preserve FP32 arithmetic, ZA selectors 0\u20133, tile mapping, increasing-k accumulation, allocation, transpose, and general tails. This source variant is absent from the supplied measured history. The compiler may produce equivalent code. Compilation, correctness, and performance remain unverified; retain the incumbent pending correctness checks and repeated paired AC trials under unchanged gates.", "adjudication": {"decision": "revise", "reason": "The candidate passed the supplied correctness checks, but eligible=false blocks adoption. Paired AC throughput changes were \u221249.2%, +45.7%, and \u22127.4%. Candidate scores ranged from 811.70\u20131483.07 GFLOP/s; controls ranged from 1017.60\u20131597.04 GFLOP/s. Two losses, one gain, and large repeat variation do not establish a stable improvement or its cause. Retain the incumbent and use this inconclusive result to inform the next jointly ranked implementation under unchanged benchmark and promotion gates."}, "compiler": "Apple clang21 with fixed optimization flags", "fmopa_basic_blocks": [{"function": "_sme_gemm", "label": "LBB2_7", "instructions": ["add\tx15, x7, x26", "ld1w\t{ z0.s }, p0/z, [x15]", "add\tx15, x24, x26", "ld1w\t{ z1.s }, p2/z, [x15]", "add\tx15, x12, x26", "ld1w\t{ z2.s }, p3/z, [x15]", "fmopa\tza0.s, p0/m, p2/m, z0.s, z1.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z2.s", "add\tx15, x20, x26", "ld1w\t{ z0.s }, p1/z, [x15]", "fmopa\tza2.s, p1/m, p2/m, z0.s, z1.s", "fmopa\tza3.s, p1/m, p3/m, z0.s, z2.s", "add\tx26, x26, x14", "subs\tx28, x28, #1", "b.ne\tLBB2_7", "cmp\tw9, #1", "b.lt\tLBB2_5", "cmp\tw0, w25", "b.le\tLBB2_13", "mov\tx12, #0                         ; =0x0", "mov\tx15, #0                         ; =0x0"]}], "all_blocks_count": 1, "baseline_conditions": "Prior AC block; user was not asked to remain idle", "source": null}, {"name": "cache_blocking", "source_hash": "b72c1ae1d1fe31878d2b3d52e0c9851277dc10f61d224c649dcc187cbbcf66d1", "scores": [1002.4065848223175, 1561.4247713026978, 1462.863518238312], "control_scores": [1074.455309285413, 1446.1169198426464, 1343.2923019486238], "hypothesis": "Explicitly unroll the incumbent reduction loop by two, applying the four FP32 MOPAs for k before those for k+1. Keep ZA selectors 0\u20133, predicates, transpose layout, allocation, and output stores unchanged. A final reduction step handles odd n without reading past the input. This source variant is absent from the supplied measured history. Reduced loop-control overhead is an unverified hypothesis; compilation, correctness at tolerance 0.002, and performance have not been tested. Retain the incumbent pending general-size correctness checks and fresh repeated serial AC paired trials under unchanged gates.", "adjudication": {"decision": "revise", "reason": "The candidate passed the supplied correctness checks, but eligible=false blocks adoption. Paired AC throughput changes were \u22126.7%, +8.0%, and +8.9%. Candidate scores ranged from 1002.41\u20131561.42 GFLOP/s; controls ranged from 1074.46\u20131446.12 GFLOP/s. Mixed paired results and large repeat variation do not establish a stable improvement or its cause. Retain the incumbent and use this inconclusive evidence to inform the next jointly ranked implementation under unchanged gates."}, "compiler": "Apple clang21 with fixed optimization flags", "fmopa_basic_blocks": [{"function": "_sme_gemm", "label": "LBB2_8", "instructions": ["add\tx12, x23, x20", "ld1w\t{ z0.s }, p0/z, [x12]", "add\tx12, x26, x20", "ld1w\t{ z1.s }, p1/z, [x12]", "add\tx12, x2, x20", "ld1w\t{ z2.s }, p2/z, [x12]", "add\tx12, x19, x20", "ld1w\t{ z3.s }, p3/z, [x12]", "fmopa\tza0.s, p0/m, p2/m, z0.s, z2.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z3.s", "fmopa\tza2.s, p1/m, p2/m, z1.s, z2.s", "fmopa\tza3.s, p1/m, p3/m, z1.s, z3.s", "add\tx12, x22, x20", "ld1w\t{ z0.s }, p0/z, [x12]", "add\tx12, x27, x20", "ld1w\t{ z1.s }, p1/z, [x12]", "add\tx12, x4, x20", "ld1w\t{ z2.s }, p2/z, [x12]", "add\tx12, x13, x20", "ld1w\t{ z3.s }, p3/z, [x12]", "fmopa\tza0.s, p0/m, p2/m, z0.s, z2.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z3.s", "fmopa\tza2.s, p1/m, p2/m, z1.s, z2.s", "fmopa\tza3.s, p1/m, p3/m, z1.s, z3.s", "add\tx7, x7, #2", "add\tx20, x20, x15", "cmp\tx7, x10", "b.lo\tLBB2_8", "cmp\tw0, w7", "b.hi\tLBB2_12", "cmp\tw9, #1", "b.ge\tLBB2_13", "b\tLBB2_5"]}, {"function": "_sme_gemm", "label": "LBB2_12", "instructions": ["umull\tx12, w7, w11", "lsl\tx12, x12, #2", "ldr\tx13, [sp, #72]                  ; 8-byte Folded Reload", "add\tx13, x13, x12", "ld1w\t{ z0.s }, p0/z, [x13, x8, lsl #2]", "ld1w\t{ z1.s }, p1/z, [x13, x1, lsl #2]", "add\tx12, x6, x12", "ld1w\t{ z2.s }, p2/z, [x12, x24, lsl #2]", "cmp\tw0, w5", "csel\tx13, x5, x24, gt", "lsl\tx13, x13, #32", "add\tx12, x12, x13, asr #30", "ld1w\t{ z3.s }, p3/z, [x12]", "fmopa\tza0.s, p0/m, p2/m, z0.s, z2.s", "fmopa\tza1.s, p0/m, p3/m, z0.s, z3.s", "fmopa\tza2.s, p1/m, p2/m, z1.s, z2.s", "fmopa\tza3.s, p1/m, p3/m, z1.s, z3.s", "cmp\tw9, #1", "b.lt\tLBB2_5"]}], "all_blocks_count": 2, "baseline_conditions": "Prior AC block; user was not asked to remain idle", "source": "#include <arm_sve.h>\n#include <arm_sme.h>\n#include <stdlib.h>\n#include <stddef.h>\n\n/* Transpose layout: at[k*n+i]. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_transpose(int n, const float *a, float *at) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        const int rows0 = n-i < vl ? n-i : vl;\n        const int rows1 = n-i-vl < vl ? n-i-vl : vl;\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int k = 0; k < n; k += 2*vl) {\n            const int cols0 = n-k < vl ? n-k : vl;\n            const int cols1 = n-k-vl < vl ? n-k-vl : vl;\n            svbool_t pk0 = svwhilelt_b32(k, n);\n            svbool_t pk1 = svwhilelt_b32(k+vl, n);\n            for (int r = 0; r < rows0; ++r) {\n                svld1_hor_za32(0, r, pk0, a+(size_t)(i+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(1, r, pk1, a+(size_t)(i+r)*n+k+vl);\n            }\n            for (int r = 0; r < rows1; ++r) {\n                svld1_hor_za32(2, r, pk0, a+(size_t)(i+vl+r)*n+k);\n                if (cols1 > 0)\n                    svld1_hor_za32(3, r, pk1, a+(size_t)(i+vl+r)*n+k+vl);\n            }\n            for (int s = 0; s < cols0; ++s) {\n                svst1_ver_za32(0, s, pi0, at+(size_t)(k+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(2, s, pi1, at+(size_t)(k+s)*n+i+vl);\n            }\n            for (int s = 0; s < cols1; ++s) {\n                svst1_ver_za32(1, s, pi0, at+(size_t)(k+vl+s)*n+i);\n                if (rows1 > 0)\n                    svst1_ver_za32(3, s, pi1, at+(size_t)(k+vl+s)*n+i+vl);\n            }\n        }\n    }\n}\n\n/* Four FP32 ZA tiles hold a 2VL x 2VL output block. */\n__attribute__((target(\"sme\")))\n__arm_new(\"za\") __arm_locally_streaming\nstatic void sme_gemm(int n, const float *at, const float *b, float *c) {\n    const int vl = (int)svcntsw();\n    for (int i = 0; i < n; i += 2*vl) {\n        svbool_t pi0 = svwhilelt_b32(i, n);\n        svbool_t pi1 = svwhilelt_b32(i+vl, n);\n        for (int j = 0; j < n; j += 2*vl) {\n            svbool_t pj0 = svwhilelt_b32(j, n);\n            svbool_t pj1 = svwhilelt_b32(j+vl, n);\n            svzero_za();\n\n            int k = 0;\n            for (; k < n-1; k += 2) {\n                /* Complete step k before step k+1. */\n                {\n                    svfloat32_t a0 = svld1_f32(pi0, at+(size_t)k*n+i);\n                    svfloat32_t a1 = svld1_f32(pi1, at+(size_t)k*n+(i+vl<n ? i+vl : i));\n                    svfloat32_t b0 = svld1_f32(pj0, b+(size_t)k*n+j);\n                    svfloat32_t b1 = svld1_f32(pj1, b+(size_t)k*n+(j+vl<n ? j+vl : j));\n                    svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                    svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                    svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                    svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n                }\n                {\n                    svfloat32_t a0 = svld1_f32(pi0, at+(size_t)(k+1)*n+i);\n                    svfloat32_t a1 = svld1_f32(pi1, at+(size_t)(k+1)*n+(i+vl<n ? i+vl : i));\n                    svfloat32_t b0 = svld1_f32(pj0, b+(size_t)(k+1)*n+j);\n                    svfloat32_t b1 = svld1_f32(pj1, b+(size_t)(k+1)*n+(j+vl<n ? j+vl : j));\n                    svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                    svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                    svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                    svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n                }\n            }\n\n            /* One remaining step when n is odd. */\n            if (k < n) {\n                svfloat32_t a0 = svld1_f32(pi0, at+(size_t)k*n+i);\n                svfloat32_t a1 = svld1_f32(pi1, at+(size_t)k*n+(i+vl<n ? i+vl : i));\n                svfloat32_t b0 = svld1_f32(pj0, b+(size_t)k*n+j);\n                svfloat32_t b1 = svld1_f32(pj1, b+(size_t)k*n+(j+vl<n ? j+vl : j));\n                svmopa_za32_f32_m(0, pi0, pj0, a0, b0);\n                svmopa_za32_f32_m(1, pi0, pj1, a0, b1);\n                svmopa_za32_f32_m(2, pi1, pj0, a1, b0);\n                svmopa_za32_f32_m(3, pi1, pj1, a1, b1);\n            }\n\n            for (int r = 0; r < vl && i+r < n; ++r) {\n                svst1_hor_za32(0, r, pj0, c+(size_t)(i+r)*n+j);\n                if (j+vl < n)\n                    svst1_hor_za32(1, r, pj1, c+(size_t)(i+r)*n+j+vl);\n            }\n            for (int r = 0; r < vl && i+vl+r < n; ++r) {\n                svst1_hor_za32(2, r, pj0, c+(size_t)(i+vl+r)*n+j);\n                if (j+vl < n)\n                    svst1_hor_za32(3, r, pj1, c+(size_t)(i+vl+r)*n+j+vl);\n            }\n        }\n    }\n}\n\nvoid gemm(int n, const float *restrict A, const float *restrict B,\n          float *restrict C) {\n    if (n <= 0)\n        return;\n\n    float *at = malloc((size_t)n*n*sizeof(float));\n    if (!at) {\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                float x = 0;\n                for (int k = 0; k < n; ++k)\n                    x += A[(size_t)i*n+k]*B[(size_t)k*n+j];\n                C[(size_t)i*n+j] = x;\n            }\n        }\n        return;\n    }\n\n    sme_transpose(n, A, at);\n    sme_gemm(n, at, B, C);\n    free(at);\n}\n"}]
