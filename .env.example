# Weights & Biases — required. Weave tracing and, per spec.md §8.1, the agent
# model provider. Never commit the real values; this file ships empty on purpose.
WANDB_API_KEY=
WANDB_PROJECT=sera
WANDB_ENTITY=

# W&B Inference drives the specialist agents through its OpenAI-compatible API.
# spec.md §8.1 sets the MVP default agent model.
SERA_AGENT_BASE_URL=https://api.inference.wandb.ai/v1
SERA_AGENT_MODEL=openai/gpt-oss-20b
SERA_AGENT_API_KEY=

# Real GPU trial substrate. Leave blank to force the simulator, which is what the
# test suite and any machine without an NVIDIA GPU will use.
SERA_VLLM_HOST=

# Hugging Face token, only needed for gated model repositories.
HF_TOKEN=
