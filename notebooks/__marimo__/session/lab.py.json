            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><table>\n<thead>\n<tr>\n<th></th>\n<th></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><strong>Model</strong></td>\n<td><code>Qwen/Qwen3-8B</code></td>\n</tr>\n<tr>\n<td><strong>Vendor</strong></td>\n<td>Alibaba</td>\n</tr>\n<tr>\n<td><strong>Size</strong></td>\n<td>8.2B parameters, 36 layers, 8 KV heads x 128</td>\n</tr>\n<tr>\n<td><strong>Device</strong></td>\n<td>RTX PRO 6000 Blackwell, 96 GB</td>\n</tr>\n<tr>\n<td><strong>Workload</strong></td>\n<td>1.0 req/s, 1024 in / 128 out, 45s</td>\n</tr>\n<tr>\n<td><strong>Latency target</strong></td>\n<td>p95 under 2800 ms</td>\n</tr>\n<tr>\n<td><strong>Quality floor</strong></td>\n<td>0.975</td>\n</tr>\n</tbody>\n</table></span>"
