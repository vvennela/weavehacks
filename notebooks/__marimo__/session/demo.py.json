          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"an-agentic-inference-optimization-team\">An agentic inference optimization team</h1>\n<span class=\"paragraph\">Three specialists tune a model's serving configuration, argue over a bounded\ntrial budget, and write every result to a ledger \u2014 including the failures.\nA second phase re-reads that ledger asking a <em>different</em> question and finds\nout whether two models can share one GPU.</span>\n<span class=\"paragraph\"><strong>Phase 1: how should each model run?</strong>\n<strong>Phase 2: how should they share the hardware?</strong></span>\n<span class=\"paragraph\">Everything here executes live. Nothing is a recording.</span></span>"
          }
        }
      ],
      "console": []
    },
