            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>The fastest config is the wrong answer here.</strong> Every point cleared SLO and quality in Phase 1. The ones marked <em>2 devices</em> occupy both GPUs \u2014 which is the opposite of what freeing a GPU requires, however fast they are.</span></span><marimo-ui-element object-id='ROlb-0' random-id='4ae18daf-ae8c-9bf9-0730-b09ca1b33666'><marimo-vega data-initial-value='{}' data-label='null' data-spec='{&quot;config&quot;:{&quot;view&quot;:{&quot;continuousWidth&quot;:300,&quot;continuousHeight&quot;:300,&quot;strokeWidth&quot;:0},&quot;axis&quot;:{&quot;domainColor&quot;:&quot;#c3c2b7&quot;,&quot;grid&quot;:true,&quot;gridColor&quot;:&quot;#e1e0d9&quot;,&quot;gridWidth&quot;:1,&quot;labelColor&quot;:&quot;#52514e&quot;,&quot;labelFontSize&quot;:11,&quot;tickColor&quot;:&quot;#c3c2b7&quot;,&quot;titleColor&quot;:&quot;#52514e&quot;,&quot;titleFontSize&quot;:11,&quot;titleFontWeight&quot;:&quot;normal&quot;},&quot;legend&quot;:{&quot;labelColor&quot;:&quot;#52514e&quot;,&quot;labelFontSize&quot;:11,&quot;symbolSize&quot;:110,&quot;symbolStrokeWidth&quot;:0,&quot;symbolType&quot;:&quot;square&quot;,&quot;titleColor&quot;:&quot;#52514e&quot;,&quot;titleFontSize&quot;:11,&quot;titleFontWeight&quot;:&quot;normal&quot;}},&quot;data&quot;:{&quot;url&quot;:&quot;data:text/csv;base64,&quot;,&quot;format&quot;:{&quot;type&quot;:&quot;csv&quot;}},&quot;facet&quot;:{&quot;column&quot;:{&quot;field&quot;:&quot;model&quot;,&quot;header&quot;:{&quot;labelColor&quot;:&quot;#0b0b0b&quot;,&quot;labelFontSize&quot;:12},&quot;title&quot;:null,&quot;type&quot;:&quot;nominal&quot;}},&quot;spec&quot;:{&quot;layer&quot;:[{&quot;mark&quot;:{&quot;type&quot;:&quot;point&quot;,&quot;filled&quot;:true,&quot;size&quot;:150,&quot;stroke&quot;:&quot